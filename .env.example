# Copy to .env (or .env.development / .env.production): @colyseus/tools loads it on start.
# Every value is validated on start (src/config/env.ts); an invalid one stops the server with a message naming it.

PORT=2567
# Bind one interface instead of all of them (the local dev backend uses 127.0.0.1).
# HOST=127.0.0.1

# Required. MySQL 8.4; use deployment secrets, never commit real values.
# DATABASE_URL=mysql://party:<url-safe-password>@mysql:3306/party

# Optional: share seats, presence and rate limits between several server processes (Redis 6.2+).
# REDIS_URL=redis://redis:6379
PARTY_REDIS_PREFIX=party:production

# Browser origins allowed to use the API and sockets, comma-separated. Empty allows any origin (development).
ALLOWED_ORIGINS=

# Content: an exported bundle (npm run content -- export). Default: the catalogs in game_config.
# PARTY_CONTENT_BUNDLE=/absolute/path/party-bundle.json
# Season policy. Default: game_config/season.json.
# PARTY_SEASON_CATALOG=/absolute/path/season.json
# Timed events. Default: game_config/events.json.
# PARTY_EVENTS_CATALOG=/absolute/path/events.json
# Matchmaking rules. Default: party-matchmaking.json next to PARTY_CONTENT_BUNDLE, else game_config.
# PARTY_MATCHMAKING_CATALOG=/absolute/path/party-matchmaking.json

# Store packs. Default: game_config/party-store.json (a missing file means no store).
# PARTY_STORE_CATALOG=/absolute/path/party-store.json
# In-app purchases (docs: README "Store"). Demo purchases grant packs without payment and need the catalog's
# demoPurchases too; default on outside production, off in production (set 1 only for a public demo build).
# PARTY_IAP_DEMO_PURCHASES=0
# Google Play Developer API service account: a key file, or the JSON itself. Never commit or log it.
# PARTY_IAP_GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/play-service-account.json
# PARTY_IAP_GOOGLE_SERVICE_ACCOUNT_JSON=
# Apple root certificates (DER .cer files). Default: certs/apple in the server folder.
# PARTY_IAP_APPLE_ROOT_CERTS_DIR=/absolute/path/apple-roots
# Check certificate revocation with Apple (OCSP) for App Store receipts (0 or 1).
PARTY_IAP_APPLE_ONLINE_CHECKS=1

# Admin endpoints and the GM console (/gm) stay off until a key is set. Use a long random value (32+ characters).
# PARTY_ADMIN_KEY=
# Addresses or CIDR ranges allowed to reach /gm and /api/admin, comma-separated (e.g. localhost,203.0.113.7). Empty = any.
# PARTY_ADMIN_ALLOWED_IPS=
# Wrong admin keys from one address before it is locked out (1-1000), and the lockout length in seconds (10-86400).
PARTY_ADMIN_MAX_FAILURES=10
PARTY_ADMIN_LOCKOUT_SECONDS=900
# Hours before a player may change their display name again (0-8760; 0 = no limit). The first change is always free.
PARTY_RENAME_COOLDOWN_HOURS=24
# Extra forbidden words for display names, one per line (# comments). Default: game_config/name-blocklist.txt if present.
# PARTY_NAME_BLOCKLIST=/absolute/path/name-blocklist.txt
# Where an uploaded content bundle is staged for the next restart.
# PARTY_CONTENT_STAGE=/absolute/path/next-bundle.json

# On shutdown, running matches may finish for up to this many seconds (0-300).
PARTY_DRAIN_SECONDS=45
PARTY_MAINTENANCE=0
PARTY_MAINTENANCE_MESSAGE=
# REST requests per address per minute (30-10000).
PARTY_API_REQUESTS_PER_MINUTE=240
# Only behind a trusted reverse proxy (0-3 hops).
PARTY_TRUST_PROXY_HOPS=0

# Compose only: distinct URL-safe passwords (e.g. generated hex values).
# PARTY_MYSQL_PASSWORD=
# PARTY_MYSQL_ROOT_PASSWORD=
